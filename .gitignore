# Installed by `npm ci` in docs/ — 1,879 files / ~14 MB that regenerate exactly from
# docs/package-lock.json, so they do not belong in git. (They were committed before this
# file existed; `git rm -r --cached docs/node_modules` removes them from tracking without
# deleting them locally.)
docs/node_modules/

# Generated by `node docs/scripts/build-site.js` on every pipeline run and published to
# GitHub Pages from the run's own artifact — never served from the repository.
docs/site/

# Robot Framework output for a capture run (log.html / report.html / output.xml).
# Uploaded as the `robot-results` artifact instead. NOTE: log.html can contain the
# session id from the frontdoor login URL, which is another reason not to commit it.
docs/capture/robot/DocsProject/results/

# Salesforce CLI / editor local state
.sfdx/
.sf/
node_modules/
__pycache__/
*.pyc

# Local capture-panel env (never commit an org token)
.env
